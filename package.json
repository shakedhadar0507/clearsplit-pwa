{
  "name": "clearsplit-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test --trace off",
    "check:pwa": "node scripts/check-pwa.mjs dist",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-query": "^5.108.0",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4",
    "typescript": "5.8",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "1.0",
    "vitest": "^3.2.7"
  }
